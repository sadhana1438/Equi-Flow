# ==========================================
# EQUIFLOW BACKEND CONFIGURATION TEMPLATE
# ==========================================

# Database Connection URL:
# Option 1: Local SQLite (Default - zero setup):
DATABASE_URL=sqlite:///./equiflow.db

# Option 2: Production PostgreSQL (Supabase, Neon, AWS RDS, GCP Cloud SQL):
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Server Port (Default: 8000)
PORT=8000

# JWT Auth Secret (Used to sign authentication tokens):
# Generate a secure secret e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Allowed CORS Origins (comma-separated):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub Webhook Secret (HMAC-SHA256 signature verification):
# Set this to the secret configured in your GitHub repository/organization webhook settings
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

